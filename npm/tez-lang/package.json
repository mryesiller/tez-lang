{
  "name": "tez-lang",
  "version": "0.2.0",
  "description": "Tez: a fast, verified programming language for LLMs and the browser. The compiler (WebAssembly) and the `tez` command for Node.",
  "type": "module",
  "bin": { "tez": "bin/tez.mjs" },
  "main": "src/api.mjs",
  "exports": {
    ".": "./src/api.mjs",
    "./runtime": "./runtime/tez-runtime.mjs",
    "./app": "./runtime/tez-app.mjs"
  },
  "files": ["bin", "src", "wasm", "runtime", "templates", "grammar.ebnf", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "engines": { "node": ">=22" },
  "keywords": ["language", "compiler", "wasm", "wasmgc", "llm", "verification"],
  "license": "MIT OR Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/mryesiller/tez-lang.git", "directory": "npm/tez-lang" },
  "homepage": "https://mryesiller.github.io/tez-lang/",
  "bugs": "https://github.com/mryesiller/tez-lang/issues",
  "optionalDependencies": { "z3-solver": "^5.2.0" },
  "scripts": { "test": "node --test test/cli.test.mjs" }
}
