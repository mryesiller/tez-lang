type Model = { left: Int where it >= 0, running: Bool }

type Msg = Tick | Toggle | Reset

fn init() -> Model = Model { left: 10, running: false }

fn update(m: Model, msg: Msg) -> Model = match msg {
  Tick => if m.left > 1 { m with { left: m.left - 1 } } else { Model { left: 0, running: false } }
  Toggle => if m.left == 0 { m } else { m with { running: !m.running } }
  Reset => init()
}

// every second while running
fn subs(m: Model) -> List[Sub[Msg]] = if m.running { [Sub.every(1000, Tick)] } else { [] }

fn view(m: Model) -> Html[Msg] =
  Html.node(
    "section",
    [UiProp("class", "col")],
    [
      Html.heading(if m.left == 0 { "Liftoff!" } else { m.left.toStr() }),
      Html.node(
        "ul",
        [],
        List.range(0, m.left).map(i => Html.node("li", [], [Html.text("#" ++ i.toStr())]))
      ),
      Html.row(
        [
          Html.button(if m.running { "Pause" } else { "Start" }, Toggle),
          Html.button("Reset", Reset)
        ]
      )
    ]
  )

test countsDown = update(init(), Tick).left == 9

test stopsAtZero = update(Model { left: 1, running: true }, Tick).left == 0

test stopsTheClockAtZero = subs(update(Model { left: 1, running: true }, Tick)).isEmpty()

test startsPaused = subs(init()).isEmpty()

fn main() -> (Int, Int) =
  (update(update(init(), Tick), Tick).left, subs(update(init(), Toggle)).len())
