type Model = { password: Str }

type Msg = Typed(Str)

fn init() -> Model = Model { password: "" }

fn update(m: Model, msg: Msg) -> Model = match msg {
  Typed(s) => Model { password: s }
}

fn hasDigit(s: Str) -> Bool = s.chars().any(c => c.toInt().isSome())

fn hasUpper(s: Str) -> Bool = s.chars().any(c => c != c.lower())

fn score(s: Str) -> Int =
  (if s.len() >= 8 { 1 } else { 0 }) +
    (if hasDigit(s) { 1 } else { 0 }) +
    (if hasUpper(s) { 1 } else { 0 })

fn label(n: Int) -> Str = if n == 3 { "strong" } else if n == 2 { "ok" } else { "weak" }

fn bar(n: Int) -> Html[Msg] =
  Html.node(
    "div",
    [
      UiProp("class", "bar " ++ label(n)),
      UiProp("style", "height: 10px; border-radius: 5px; width: " ++ (n * 33 + 1).toStr() ++ "%;")
    ],
    []
  )

fn view(m: Model) -> Html[Msg] =
  Html.col(
    [
      Html.heading("Password strength"),
      Html.input(m.password, s => Typed(s)),
      bar(score(m.password)),
      Html.paragraph(
        label(score(m.password)) ++ " (" ++ score(m.password).toStr() ++ " of 3 checks)"
      )
    ]
  )

test emptyIsWeak = label(score("")) == "weak"

test strongPassword = label(score("Tez2026ok")) == "strong"

test digitsOnlyCountOnce = score("123") == 1

fn main() -> (Int, Int) = (score("abc"), score("Abcdefg1"))
