type Shape = Circle(Int) | Rect(Int, Int) | Triangle(Int, Int)

fn area(s: Shape) -> Int = match s {
  Circle(r) => 3 * r * r
  Rect(w, h) => w * h
  Triangle(b, h) => b * h / 2
}

fn describe(s: Shape) -> Str = match s {
  Circle(_) => "circle"
  Rect(w, h) if w == h => "square"
  Rect(_, _) => "rectangle"
  Triangle(_, _) => "triangle"
}

fn main() -> List[(Str, Int)] =
  [Circle(2), Rect(3, 3), Rect(2, 5), Triangle(4, 5)].map(s => (describe(s), area(s)))
